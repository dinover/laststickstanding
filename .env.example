# Copiar a .env y completar antes de "docker compose up -d".
#
# Dominio (o subdominio nip.io) que apunta a la IP pública de la VM. Caddy lo usa para
# pedir el certificado TLS automáticamente vía Let's Encrypt. Ver oracle/README-oracle.md
# para las dos formas de conseguir uno (dominio propio o nip.io sin costo).
DOMAIN=laststickstanding.example.com

# Imagen a usar: Dockerfile (compila adentro, para CI o máquinas grandes) o Dockerfile.prebuilt
# (usa los artefactos que sube scripts/deploy-vm.sh; recomendado en la VM de ~500 MB).
LSS_DOCKERFILE=Dockerfile.prebuilt
