{
  "name": "last-stick-standing-desktop",
  "version": "1.0.0",
  "description": "Last Stick Standing - version de escritorio instalable, ventana sobre el server online (WebSocket).",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.lastonestanding.laststickstanding",
    "productName": "Last Stick Standing",
    "icon": "../LSS icon.png",
    "files": [
      "main.js",
      "offline.html"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "script": "build/installer.nsi"
    }
  }
}
